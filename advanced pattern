//easy diamond shape 
class Main {
    public static void main(String[] args) {
        int n=5;
        for(int i=1;i<=n;i++){
            //space 
            for( int j=1;j<=n-i;j++){
                System.out.print(" ");
            }
            //1st half
            int star = 2*i-1;
            for(int j=1;j<=star;j++){
                System.out.print("*");
            }
            
            System.out.println(" ");
        }
        //second half
        for(int i=n;i>=1;i--){
            //space 
            for( int j=1;j<=n-i;j++){
                System.out.print(" ");
            }
            //1st half
            int star = 2*i-1;
            for(int j=1;j<=star;j++){
                System.out.print("*");
            }
            
            System.out.println(" ");
        }
    }
}
