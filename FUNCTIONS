package com.student.managment;
import java.util.*;
public class Functions {
	public static int addOfOdd(int n) {
		int sum=0;
		for(int i=1;i<=n;i++) {
			if(i%2==0) {
			    sum=sum+i;
			}
		}
		return sum;
	}
	public static void main(String args[] ) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int result = addOfOdd(n);
        System.out.println("The sum of odd numbers up to " + n + " is: " + result);
        
        sc.close();
		
	}
    
